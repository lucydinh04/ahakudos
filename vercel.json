{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/page.js": {"includeFiles": "private/**", "maxDuration": 60},
    "api/bridge.js": {"maxDuration": 60}
  },
  "rewrites": [
    {"source": "/", "destination": "/api/page"},
    {"source": "/kudos", "destination": "/api/page"}
  ],
  "headers": [
    {"source": "/backgrounds/(.*)", "headers": [{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source": "/(.*)", "headers": [
      {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"X-Content-Type-Options","value":"nosniff"}
    ]}
  ]
}
